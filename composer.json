{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bojobayran24/pds-auto-compute",
    "type": "project",
    "description": "Minimalist, privacy-first CS Form No. 212 (Revised 2025) PDS Work Experience & Training Auto-Compute Web Application ready for Vercel.",
    "keywords": ["laravel", "pds", "cs-form-212", "gemini-api", "vercel", "hr-evaluation"],
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
