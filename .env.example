APP_NAME="PDS Auto-Compute"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_32B=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

# Shared Passcode Gate (Wrap in double quotes if passcode contains spaces; leave blank to disable)
APP_ACCESS_PASSCODE="psarsps 2027"

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=55

# Zero-DB Privacy-First Cookie Session & Ephemeral Runtime Settings
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Serverless-ready logging & ephemeral rate-limit cache (Zero DB Persistence)
LOG_CHANNEL=stderr
LOG_LEVEL=error
CACHE_STORE=file
QUEUE_CONNECTION=sync
